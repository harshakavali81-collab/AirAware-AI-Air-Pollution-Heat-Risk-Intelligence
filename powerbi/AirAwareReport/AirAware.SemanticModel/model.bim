{
  "name": "AirAware",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Readings",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "station",
            "dataType": "string",
            "sourceColumn": "station"
          },
          {
            "name": "pm25",
            "dataType": "double",
            "sourceColumn": "pm25",
            "formatString": "0.0"
          },
          {
            "name": "source",
            "dataType": "string",
            "sourceColumn": "source"
          }
        ],
        "measures": [
          {
            "name": "Average PM2.5",
            "expression": "AVERAGE(Readings[pm25])",
            "formatString": "0.0"
          },
          {
            "name": "Reporting Stations",
            "expression": "DISTINCTCOUNT(Readings[station])",
            "formatString": "0"
          },
          {
            "name": "Observed Station Days",
            "expression": "COUNTROWS(Readings)",
            "formatString": "0"
          },
          {
            "name": "Peak Daily PM2.5",
            "expression": "MAXX( SUMMARIZE(Readings, Readings[date], \"daily\", AVERAGE(Readings[pm25])), [daily])",
            "formatString": "0.0"
          }
        ],
        "partitions": [
          {
            "name": "Readings",
            "mode": "import",
